{
  "name": "gta3-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "compress": "sh ./scripts/compress.sh",
    "extract": "sh ./scripts/extract-all.sh",
    "dev": "vite",
    "format:check": "prettier -c src",
    "format:write": "prettier -w src",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/redux-logger": "^3.0.13",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.2.0",
    "redux-logger": "^3.0.6",
    "redux-saga": "^1.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
